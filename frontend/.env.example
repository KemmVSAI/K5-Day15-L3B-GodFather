# Python medication backend. Start it with: python run.py web (from repo root).
# Server-only: never expose model API keys through VITE_* variables.
MEDICATION_API_URL=http://127.0.0.1:8000

# Custom health check message
PING_MESSAGE=pong

# Skip login/signup (local dev / preview only)
# Auth is enabled when AUTH_DISABLED is unset. Standalone production deploys
# need a stable BETTER_AUTH_SECRET; BETTER_AUTH_URL is inferred automatically.
# BETTER_AUTH_SECRET=
# AUTH_DISABLED=true
